{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://intentspec.org/schema.json",
    "title": "IntentSpec",
    "description": "A portable, evidence-backed format for AI agent intent.",
    "type": "object",
    "required": ["id", "status", "objective", "outcomes"],
    "properties": {
        "id": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "validated", "approved", "shipped", "verified"], "default": "draft" },
        "version": { "type": "integer", "default": 1 },
        "objective": { "type": "string" },
        "problemSeverity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "userGoal": { "type": "string" },
        "outcomes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "healthMetrics": { "type": "array", "items": { "type": "string" } },
        "verification": { "type": "array", "items": { "type": "string" } },
        "scope": { "type": "object", "properties": { "inScope": { "type": "array", "items": { "type": "string" } }, "outOfScope": { "type": "array", "items": { "type": "string" } } } },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "edgeCases": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "scenario": { "type": "string" }, "expectedBehavior": { "type": "string" } }, "required": ["scenario", "expectedBehavior"] } },
        "evidence": { "type": "array", "items": { "type": "object", "required": ["type", "excerpt"], "properties": { "id": { "type": "string" }, "type": { "type": "string", "enum": ["friction", "quote", "observation", "metric", "request"] }, "source": { "type": "string" }, "excerpt": { "type": "string" }, "anchors": { "type": "array", "items": { "type": "string" } } } } },
        "strategicAlignment": { "type": "string", "enum": ["high", "medium", "low", "deviation"] },
        "alignmentNotes": { "type": "string" },
        "createdAt": { "type": "integer" },
        "updatedAt": { "type": "integer" }
    }
}
