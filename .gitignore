# Dependencies
node_modules/

# Build output
dist/
.next/
out/
*.tsbuildinfo

# Turbo
.turbo/

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Environment and secrets. Copy .env.example to .env and keep real values local.
# The pre-commit hook and CI (scripts/check-pii.mjs) refuse these even if force-added.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test
coverage/

# Temp
tmp/

# IntentGuard local state. Specs, proof reports, and config.json are committed; the active pointer is not.
.intent/active.json

# AI agent integrations: generated from backend/core/src/agents by `pnpm agents:setup`.
# Each agent only reads its own fixed path, so these cannot share a folder.
.mcp.json
.cursor/
.codex/
.bob/

# Personal Claude Code settings (permissions, local paths)
.claude/settings.local.json
