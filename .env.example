# IntentGuard environment. Copy to .env (git-ignored) in the IntentGuard folder and fill in
# real values locally. The chat agent, the API server, and the MCP server load it automatically
# (variables already set in your shell win). Keys stay here: connected repositories never get them.
# Never commit real values; the pre-commit hook and CI refuse them.

# --- OpenAI (chat agent and spec drafting; the default provider) ---

OPENAI_API_KEY=your-openai-api-key
# Tool-calling model. Default: gpt-4.1 (list what your key offers with `pnpm chat --list-models`).
# OPENAI_MODEL=gpt-4.1
# Only for a proxy or an OpenAI-compatible gateway. Default: https://api.openai.com/v1
# OPENAI_BASE_URL=
# Only when your key belongs to several organizations or projects.
# OPENAI_ORG_ID=
# OPENAI_PROJECT_ID=

# --- IBM Bob ---
# Bob needs no key here. It is a coding agent that calls IntentGuard over MCP, signed in with
# your own Bob account and team. Run `pnpm connect <repo> --agent bob` to wire it up.

# --- DeepSeek (optional alternative; use with `--provider deepseek` or select in the chat UI) ---
DEEPSEEK_API_KEY=your-deepseek-api-key
# Model to use. The chat UI defaults to deepseek-flash; the API default is deepseek-chat.
# DEEPSEEK_MODEL=deepseek-chat
# Only for a proxy or a DeepSeek-compatible gateway. Default: https://api.deepseek.com/v1
# DEEPSEEK_BASE_URL=

# --- IBM watsonx.ai (optional alternative; used only when OpenAI is not configured,
#     or with `--provider watsonx` / "llmProvider": "watsonx") ---
# WATSONX_API_KEY=
# WATSONX_PROJECT_ID=
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
# WATSONX_MODEL_ID=ibm/granite-4-h-small

# --- Local Ollama (spec drafting when llmProvider is "ollama" in .intent/config.json) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=granite3.1-dense:8b

# --- IntentGuard runtime ---

# Repository the server and MCP server manage. Defaults to the git top level of the cwd.
# `pnpm dev:server --repo <path>` and `intent connect` set this for you.
# INTENT_ROOT=

# HTTP API port (default 3848, bound to 127.0.0.1 only).
INTENTGUARD_API_PORT=3848

# Extra browser origins allowed to call the API (comma-separated). The dashboard
# (http://localhost:3847) is always allowed.
# INTENTGUARD_ALLOWED_ORIGINS=

# The dashboard reads NEXT_PUBLIC_INTENTGUARD_API_URL from frontend/.env.local when the API
# is not on http://localhost:3848.
