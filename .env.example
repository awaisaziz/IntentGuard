# IntentGuard environment. Copy to .env (git-ignored) in the IntentGuard folder and fill in
# real values locally. The chat agent, the API server, and the MCP server load it automatically
# (variables already set in your shell win). Keys stay here: connected repositories never get them.
# Never commit real values; the pre-commit hook and CI refuse them.

# --- IBM watsonx.ai (chat agent; also LLM spec drafting when llmProvider is "auto" or "watsonx") ---

WATSONX_API_KEY=your-watsonx-api-key
# The watsonx project that holds your model access (or set WATSONX_SPACE_ID for a deployment space).
WATSONX_PROJECT_ID=your-watsonx-project-id
# WATSONX_SPACE_ID=
# Regional endpoint of your project. Default: https://us-south.ml.cloud.ibm.com
# WATSONX_URL=https://eu-de.ml.cloud.ibm.com
# Tool-calling model for the chat agent. Default: ibm/granite-4-h-small
# (list what your region offers with `pnpm chat --list-models`).
# WATSONX_MODEL_ID=ibm/granite-4-h-small

# --- Local Ollama (spec drafting when llmProvider is "ollama" in .intent/config.json) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=granite3.1-dense:8b

# --- IntentGuard runtime ---

# Repository the server and MCP server manage. Defaults to the git top level of the cwd.
# `pnpm dev:server --repo <path>` and `intent connect` set this for you.
# INTENT_ROOT=

# HTTP API port (default 3848, bound to 127.0.0.1 only).
INTENTGUARD_API_PORT=3848

# Extra browser origins allowed to call the API (comma-separated). The dashboard
# (http://localhost:3847) is always allowed.
# INTENTGUARD_ALLOWED_ORIGINS=

# The dashboard reads NEXT_PUBLIC_INTENTGUARD_API_URL from frontend/.env.local when the API
# is not on http://localhost:3848.
