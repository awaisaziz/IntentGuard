# IntentGuard environment. Copy to .env (git-ignored) and fill in real values locally.
# Nothing reads this file automatically: export the variables in your shell or run
# commands with `node --env-file=.env ...`. Never commit real values; the pre-commit
# hook and CI refuse them.

# --- LLM providers (optional; the rule-based fallback is used when unset) ---

# IBM watsonx.ai. Selected when llmProvider is "watsonx", or "auto" with WATSONX_API_KEY set.
WATSONX_API_KEY=your-watsonx-api-key
WATSONX_PROJECT_ID=your-watsonx-project-id

# Local Ollama. Selected when llmProvider is "ollama" in .intent/config.json.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=granite3.1-dense:8b

# --- IntentGuard runtime ---

# Repository the server and MCP server manage. Defaults to the git top level of the cwd.
# INTENT_ROOT=

# HTTP API port (default 3848, bound to 127.0.0.1 only).
INTENTGUARD_API_PORT=3848
